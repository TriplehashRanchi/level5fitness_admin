# The API this console talks to
NEXT_PUBLIC_API_URL=http://localhost:4000

# Firebase web settings (the same project as the phone app). These are public identifiers, not secrets.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Browser alerts for dietitians (Firebase console > Project settings > Cloud Messaging). Public identifiers.
# Sender ID is on the Cloud Messaging tab; the VAPID key is the key pair under "Web Push certificates".
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Developer-only email sign-in form on the login page. Leave OFF (empty) in production: staff sign in with Google.
NEXT_PUBLIC_DEV_EMAIL_LOGIN=
